#!/bin/bash
# Narrative.Rx — macOS .pkg postinstall (v2, minimal + resilient).
#
# Design change from v1: the .pkg no longer tries to install Homebrew /
# Python / MongoDB silently from a non-interactive root shell. That
# approach failed because Homebrew's installer expects a TTY and internal
# sudo calls can't prompt during pkg execution.
#
# Instead, the postinstall now:
#   1. Ensures /Library/Application Support/NarrativeRx exists and is readable
#   2. Copies logs dir + activation key
#   3. Launches setup.command in Terminal.app as the console user
#      → the user sees a friendly step-by-step wizard, can enter their
#        admin password when Homebrew needs it, and any error is visible.
#
# This guarantees the .pkg install itself never fails — the interactive
# setup can be re-run from Finder any time.

APP_DIR="/Library/Application Support/NarrativeRx"
LOG_DIR="/Library/Logs/NarrativeRx"
INSTALL_LOG="$LOG_DIR/postinstall.log"

mkdir -p "$LOG_DIR" 2>/dev/null || true
exec > >(tee -a "$INSTALL_LOG") 2>&1
echo "=== Narrative.Rx postinstall @ $(date) ==="
echo "App dir: $APP_DIR"

# --- Detect console user & UID so we can launch Terminal as them ---
CONSOLE_USER=$(stat -f '%Su' /dev/console 2>/dev/null || echo "root")
CONSOLE_UID=$(id -u "$CONSOLE_USER" 2>/dev/null || echo "0")
echo "Console user: $CONSOLE_USER (uid=$CONSOLE_UID)"

# --- Make setup.command executable ---
SETUP_CMD="$APP_DIR/mac/setup.command"
if [ -f "$SETUP_CMD" ]; then
    chmod +x "$SETUP_CMD"
    echo "setup.command ready: $SETUP_CMD"
else
    echo "WARNING: $SETUP_CMD not found — payload assembly may be broken."
fi

# --- Auto-generate practice activation key so it exists before setup runs ---
KEY_FILE="$APP_DIR/activation-key.txt"
if [ ! -f "$KEY_FILE" ]; then
    # 32-char alphanumeric alphabet with unambiguous chars only
    KEY=$(python3 - <<'PY' 2>/dev/null || echo "NRX-TEMP-KEY-0001"
import secrets
a = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
groups = ["".join(secrets.choice(a) for _ in range(4)) for _ in range(3)]
print("NRX-" + "-".join(groups))
PY
)
    echo "$KEY" > "$KEY_FILE"
    chmod 644 "$KEY_FILE"
    echo "Generated activation key: $KEY"
fi

# --- Fix permissions so console user can read setup.command / activation key ---
chmod -R a+r "$APP_DIR" 2>/dev/null || true
chown -R "$CONSOLE_USER":admin "$APP_DIR/mac" 2>/dev/null || true

# --- Open setup.command in Terminal as the console user (fire and forget) ---
if [ -n "$CONSOLE_UID" ] && [ "$CONSOLE_UID" != "0" ] && [ -f "$SETUP_CMD" ]; then
    echo "Launching Terminal for interactive setup..."
    launchctl asuser "$CONSOLE_UID" sudo -u "$CONSOLE_USER" \
        open -a Terminal "$SETUP_CMD" 2>&1 || \
        echo "(Terminal auto-launch failed — user can double-click setup.command in Finder.)"
fi

echo "=== postinstall done — installer will now report success ==="
# CRITICAL: always exit 0 so the .pkg install itself succeeds. The interactive
# setup window handles any per-machine failures separately.
exit 0
