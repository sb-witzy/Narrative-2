#!/bin/bash
# Narrative.Rx.app entry point.
# Lives at: /Applications/Narrative.Rx.app/Contents/MacOS/NarrativeRx
#
# Smart launcher — decides what to open based on install state:
#   1. Dependencies not installed yet (no .venv) -> full setup.command
#   2. Dependencies installed but no LLM key yet -> set-llm-key.command
#   3. Fully configured -> just open http://localhost:8080 in the browser

APP_DIR="/Library/Application Support/NarrativeRx"
ENV_FILE="$APP_DIR/.env"
SETUP_CMD="$APP_DIR/mac/setup.command"
KEY_CMD="$APP_DIR/mac/set-llm-key.command"
VENV_PYTHON="$APP_DIR/backend/.venv/bin/python"

# State 1: dependencies not installed -> full setup
if [ ! -x "$VENV_PYTHON" ] && [ -x "$SETUP_CMD" ]; then
    open -a Terminal "$SETUP_CMD"
    exit 0
fi

# State 2: dependencies installed but no LLM key -> quick key prompt.
# We check for a world-readable marker file (created by set-llm-key.command)
# because .env itself is chmod 600 (root only) and this launcher runs as
# the console user.
if [ ! -f "$APP_DIR/.llm-key-set" ] && [ -x "$KEY_CMD" ]; then
    open -a Terminal "$KEY_CMD"
    exit 0
fi

# State 3: fully configured -> just open the browser (wait up to 15s for
# the service to be listening in case this is a cold boot)
for _ in $(seq 1 15); do
    if curl -fsS -m 1 http://localhost:8080/api/ >/dev/null 2>&1; then
        break
    fi
    sleep 1
done
open "http://localhost:8080"
